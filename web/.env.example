# Contact form storage. Both are required for POST /api/contact; it fails closed
# without them. Neither may be prefixed NEXT_PUBLIC_ — that ships the value to the browser.

# Vercel > Storage > Postgres injects this automatically once the database is linked.
DATABASE_URL="postgres://user:password@host.neon.tech/neondb?sslmode=require"

# Salt for hashing client IPs before they are stored. Any long random string; generate
# with `openssl rand -hex 32`. Without a salt, a SHA-256 of an IPv4 address is
# reversible by brute force, so this is what makes ip_hash more than decoration.
# Changing it resets the rate-limit window for everyone. Never commit the real value.
CONTACT_IP_SALT=""

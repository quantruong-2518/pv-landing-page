# Public PV One CRM intake endpoint. These values are intentionally exposed to
# browser JavaScript; never put an API key or secret in either variable.
NEXT_PUBLIC_PV_ONE_CRM_API_URL="https://pvone-crm-api.fly.dev"

# Lowercase slug. It must also be present in PV_INTAKE_LANDING_PAGES on the CRM API.
NEXT_PUBLIC_PV_ONE_CRM_LANDING_PAGE="pv-one-main"

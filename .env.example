# Canonical origin for canonical URLs, hreflang, sitemap and JSON-LD @id.
# Must be a host that actually holds a certificate for itself. The apex
# (pebblevina.com) does not yet — see README, "Tên miền và chứng chỉ".
NEXT_PUBLIC_SITE_URL=https://www.pebblevina.com

# CMS access. Required in production: with no password set, /admin refuses to
# open rather than defaulting to public. In development an unset password
# leaves it open so a fresh clone works without setup.
ADMIN_PASSWORD=

# Optional signing key for the CMS session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=

# Where contact-form enquiries are forwarded. Unset means they are only logged
# on the server — set this before the form goes live.
CONTACT_WEBHOOK_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional: unset means GA is
# never loaded at all. When it is set, the script still only loads for visitors
# who grant the "analytics" category in the cookie banner — the consent gate is
# src/components/site/consent/analytics.tsx, not a setting here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

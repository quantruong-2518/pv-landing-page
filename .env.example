# Canonical origin for canonical URLs, hreflang, sitemap and JSON-LD @id.
NEXT_PUBLIC_SITE_URL=https://pebblevina.com

# CMS access. Required in production: with no password set, /admin refuses to
# open rather than defaulting to public. In development an unset password
# leaves it open so a fresh clone works without setup.
ADMIN_PASSWORD=

# Optional signing key for the CMS session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=

# Where contact-form enquiries are forwarded. Unset means they are only logged
# on the server — set this before the form goes live.
CONTACT_WEBHOOK_URL=

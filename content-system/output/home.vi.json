    {
      "key": "home.whyNow.points[0].title",
      "component": "list_item",
      "claims": [
        "C020"
      ],
      "locales": {
        "vi": "Trung tâm dữ liệu đã ngốn khoảng 2% điện toàn cầu"
      }
    },
    {
      "key": "home.whyNow.points[0].body",
      "component": "body",
      "claims": [
        "C020"
      ],
      "locales": {
        "vi": "Cộng thêm khoảng 300.000 gallon nước mỗi ngày để làm mát. Đây là số của ngành, không phải số đo của Pebble Square."
      }
    },
    {
      "key": "home.whyNow.points[0].media.alt",
      "component": "caption",
      "claims": [
        "C020"
      ],
      "locales": {
        "vi": "Minh hoạ một trung tâm dữ liệu đấu vào lưới điện và hệ làm mát bằng nước, bên cạnh là quả cầu ghi 2%."
      }
    },
    {
      "key": "home.whyNow.points[1].title",
      "component": "list_item",
      "locales": {
        "vi": "Chỗ cần AI nhất lại là chỗ không có điện dư"
      }
    },
    {
      "key": "home.whyNow.points[1].body",
      "component": "body",
      "locales": {
        "vi": "Trạm biến áp, dây chuyền sản xuất, tủ điện trong nhà xưởng, cảm biến chạy pin. Ngân sách điện ở những chỗ đó tính bằng miliwatt, không phải bằng watt."
      }
    },
    {
      "key": "home.whyNow.points[1].media.alt",
      "component": "caption",
      "locales": {
        "vi": "Minh hoạ một lõi AI ở giữa. Quanh nó là trạm biến áp, tấm pin mặt trời, cánh tay robot và cảm biến, mỗi thứ ghi rõ mức điện tính bằng mW."
      }
    },
    {
      "key": "home.whyNow.points[2].title",
      "component": "list_item",
      "locales": {
        "vi": "Điện tốn vào việc khiêng dữ liệu, không phải vào việc tính"
      },
      "claims": [
        "C014"
      ]
    },
    {
      "key": "home.whyNow.points[2].body",
      "component": "body",
      "locales": {
        "vi": "Máy tính thường để bộ nhớ một nơi, bộ xử lý một nơi. Dữ liệu phải chạy đi chạy lại giữa hai chỗ, và chính quãng đường đó mới ngốn điện. Chip của Pebble Square tính ngay trong mảng nhớ, nên không còn quãng đường ấy."
      },
      "claims": [
        "C014"
      ]
    },
    {
      "key": "home.whyNow.points[2].media.alt",
      "component": "caption",
      "locales": {
        "vi": "Sơ đồ so sánh: bên trái là bus dữ liệu dày nối chip với bộ nhớ rời, bên phải là mảng crossbar tính ngay trong bộ nhớ. Hai thanh bên dưới đo điện năng của mỗi bên."
      }
    },

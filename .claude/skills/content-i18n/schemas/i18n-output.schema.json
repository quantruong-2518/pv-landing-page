{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "i18n-output.schema.json",
  "title": "i18n output artifact",
  "description": "The artifact every content task emits. One envelope for marketing and product UI; content_type selects the QA rubric and the linter.",
  "type": "object",
  "required": ["content_type", "id", "locales", "entries"],
  "additionalProperties": false,
  "properties": {
    "content_type": { "enum": ["marketing", "product_ui"] },
    "id": { "type": "string", "minLength": 1 },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["vi", "en", "ko"] }
    },
    "semantic_spec": { "type": "string", "description": "Path or id of the semantic spec this was compiled from." },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["key", "locales"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_.\\[\\]-]+$" },
        "component": {
          "enum": [
            "headline", "subheadline", "body", "eyebrow", "cta", "caption", "list_item", "meta",
            "button", "label", "nav", "form_field", "placeholder", "helper_text", "tooltip",
            "empty_state", "error", "warning", "success", "notification", "dialog_title",
            "dialog_body", "destructive_dialog", "onboarding", "setting", "table_header",
            "filter", "system_state", "toast", "tab", "menu"
          ]
        },
        "claims": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{3}$" } },
        "state": { "type": "string" },
        "label": { "enum": ["shipped", "roadmap"] },
        "primary_action": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "notes": { "type": "string" },
        "locales": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}

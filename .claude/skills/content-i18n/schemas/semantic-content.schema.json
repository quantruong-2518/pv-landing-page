{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantic-content.schema.json",
  "title": "Semantic content spec",
  "description": "Language-free meaning. The only input a locale writer may read.",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["marketing", "product_ui"] },
    "intent": {
      "type": "object",
      "properties": {
        "communicate": { "type": "string" },
        "reader_question": { "type": "string" }
      }
    },
    "claims": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{3}$" } },
    "mechanisms": { "type": "array", "items": { "type": "string" } },
    "values": { "type": "array", "items": { "type": "string" } },
    "qualifiers": { "type": "array", "items": { "type": "string" } },
    "forbidden": { "type": "array", "items": { "type": "string" } },
    "cta": {
      "type": "object",
      "properties": { "intent": { "type": "string" } }
    },
    "component": { "type": "string" },
    "context": {
      "type": "object",
      "properties": {
        "screen": { "type": "string" },
        "workflow": { "type": "string" },
        "entity": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "current": { "type": "string" },
        "cause_known": { "type": "boolean" },
        "cause": { "type": "string" }
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "intent": { "type": "string" },
        "expected_action": { "type": "string" }
      }
    },
    "available_actions": { "type": "array", "items": { "type": "string" } },
    "primary_action": { "type": "string" },
    "secondary_actions": { "type": "array", "items": { "type": "string" } },
    "consequence": {
      "type": "object",
      "properties": {
        "reversible": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "action": { "type": "string" }
      }
    },
    "technical_detail": {
      "type": "object",
      "properties": {
        "expose_to_user": { "type": "boolean" },
        "value": { "type": "string" }
      }
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "terminology": { "type": "array", "items": { "type": "string" } },
    "locale": {
      "type": "object",
      "properties": {
        "requested": { "type": "array", "items": { "enum": ["vi", "en", "ko"] } }
      }
    }
  }
}

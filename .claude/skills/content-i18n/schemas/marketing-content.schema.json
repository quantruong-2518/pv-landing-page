{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "marketing-content.schema.json",
  "title": "Marketing content contract",
  "type": "object",
  "required": ["page", "audience", "product", "cta"],
  "properties": {
    "page": {
      "type": "object",
      "required": ["type", "goal"],
      "properties": {
        "type": {
          "enum": ["homepage", "landing_page", "product_page", "solution_page",
                   "use_case_page", "campaign_page", "company_page", "technology_page"]
        },
        "goal": { "type": "string" },
        "funnel_stage": { "enum": ["awareness", "consideration", "decision"] }
      }
    },
    "audience": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "buyer": { "type": "string" },
        "evaluator": { "type": "string" },
        "user": { "type": "string" },
        "awareness_level": {
          "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"]
        },
        "primary_problem": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "mechanisms": { "type": "array", "items": { "type": "string" } },
        "deployment_models": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "problems": { "type": "array", "items": { "type": "string" } },
    "buyer_values": { "type": "array", "items": { "type": "string" } },
    "proof": {
      "type": "object",
      "properties": {
        "verified": { "type": "array", "items": { "type": "string" } },
        "contextual": { "type": "array", "items": { "type": "string" } },
        "unavailable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "differentiators": { "type": "array", "items": { "type": "string" } },
    "objections": { "type": "array", "items": { "type": "string" } },
    "cta": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" }
      }
    },
    "tone": {
      "type": "object",
      "properties": {
        "desired": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims_policy": {
      "type": "object",
      "properties": {
        "allow_inference": { "type": "boolean" },
        "require_proof_for_numbers": { "type": "boolean" },
        "require_proof_for_superlatives": { "type": "boolean" }
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "requested": { "type": "array", "items": { "enum": ["vi", "en", "ko"] } }
      }
    }
  }
}

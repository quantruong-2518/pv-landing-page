{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terminology.schema.json",
  "title": "Terminology glossary",
  "type": "object",
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "locales"
        ],
        "properties": {
          "concept": {
            "type": "object",
            "properties": {
              "definition": {
                "type": "string"
              }
            }
          },
          "locales": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "preferred"
              ],
              "properties": {
                "preferred": {
                  "type": "string",
                  "minLength": 1
                },
                "forbidden": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "preserve_in_ui": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "enum": [
                "marketing",
                "product_ui"
              ]
            },
            "description": "Content types this term governs. Omit for both."
          }
        }
      }
    },
    "preserve_verbatim": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
